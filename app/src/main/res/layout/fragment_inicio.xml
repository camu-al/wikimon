<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Buscador -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/buscador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="Buscar Pokémon, movimientos o habilidades" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">
            <!-- CardView: Crear equipo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvPokemonRandom"
                android:layout_width="175dp"
                android:layout_height="150dp"
                android:layout_marginEnd="15dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/fondo_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Pokemon Random"
                        android:src="@drawable/outline_rewarded_ads_24"
                        app:tint="?attr/colorOnBackground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pokémon Random"
                        android:textColor="@color/text_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tienes buena suerte hoy?"
                        android:textColor="@color/text_secundario"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRandomPoke"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:backgroundTint="@color/boton_principal"
                        android:gravity="center"
                        android:text="PokeRoll"
                        android:textColor="@color/texto_boton" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CardView: Favoritos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvCrearEquipo"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fondo_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="CrearEqipo"
                            android:src="@drawable/outline_calendar_view_month_24"
                            app:tint="?attr/colorOnBackground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crear Equipo"
                            android:textColor="@color/text_principal"
                            android:textSize="14dp"
                            android:layout_marginEnd="5dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- CardView: Favoritos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvFavoritos"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fondo_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="Favoritos"
                            android:src="@drawable/outline_favorite_24"
                            app:tint="?attr/colorOnBackground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PokeFav"
                            android:textColor="@color/text_principal"
                            android:textSize="14dp"
                            android:layout_marginEnd="5dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFavContador"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_secundario"
                            android:textSize="14dp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
        <!-- Fin Card view Fav / crear / batalla-->

        <!-- Bienvenida -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pokémon del día"
            android:textSize="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_principal"
            android:gravity="start" />

        <!-- Pokémon del día -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPokemonDelDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRandomPokeId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:text="#0000"
                            android:textColor="@color/text_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRandomPokeNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pokeball"
                            android:textColor="@color/text_principal"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <!-- Añadir Tipos -->
                            <TextView
                                android:id="@+id/tvTipo1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:layout_marginEnd="8dp"
                                android:text="Tipo1"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_tipo" />

                            <TextView
                                android:id="@+id/tvTipo2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Tipo2"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_tipo"
                                android:visibility="gone" />

                        </LinearLayout>
                        <!-- Añadir Descripcion -->
                        <TextView
                            android:id="@+id/tvRandomPokeDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Descripción del Pokémon..."
                            android:textColor="@color/text_secundario"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgRandomPoke"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pokeball" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Fin Pokémon del día -->

        <!-- Explora las regiones -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explora las regiones"
            android:textSize="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"
            android:textColor="@color/text_principal"
            android:gravity="start"
            />

        <!-- Scroll chips de regiones -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRegiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:chipSpacing="8dp"
                app:singleLine="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
        </HorizontalScrollView>

        <!-- Pokedex captura-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvCapturasPoke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/fondo_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloProgreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:text="Progreso Global"
                            android:textColor="@color/text_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNombreProgreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Maestro Pokédex"
                            android:textColor="@color/text_principal"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvContadorProgreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:text="564 / 1123 Pokemon capturados"
                            android:textColor="@color/text_secundario"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgContadorProgreso"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/outline_rewarded_ads_24"
                        app:tint="?attr/colorOnBackground" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Fin Pokedex captura-->
    </LinearLayout>
</ScrollView>
